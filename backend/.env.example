# Copy to .env for local development. In production set these in the host's
# secret manager (Render > Environment); never commit real values.

APP_ENV=development                 # production enables strict checks
DATABASE_URL=                       # Supabase session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres (unset in dev = SQLite)
ALLOWED_ORIGINS=http://localhost:8081

# Sign-in (Clerk). REQUIRE_SIGN_IN=0 is for local development only.
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=           # e.g. https://app.example.com
REQUIRE_SIGN_IN=1
DEV_USER_ID=dev-user
ADMIN_USER_IDS=
COMPLIMENTARY_PRO_USER_IDS=         # founders/testers who get Pro without billing

# Pro
PRO_GATING=1                        # 0 unlocks every Pro feature for everyone
GRACE_DAYS=3
PRO_PRICE_DISPLAY=                  # shown in the app, e.g. "$9.99/month"; unset = "see checkout"
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_RETURN_URLS=kaventafi://       # allowed checkout return URL prefixes
REVENUECAT_WEBHOOK_AUTH=            # shared secret configured on the RevenueCat webhook

# Market data
MARKET_DATA_MODE=                   # live | demo; unset = live with TIINGO_API_KEY, else demo
TIINGO_API_KEY=
SP500_AGGREGATES_FILE=              # licensed S&P 500 per-index-share aggregates (see providers/registry.py)

# Bank linking (Plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=                  # https://<api>/api/plaid/webhook -- without it Plaid sends no sync/login events
PLAID_REDIRECT_URI=                 # the web app's /portfolio URL; needed for OAuth institutions, also set in Plaid's dashboard
FERNET_KEY=                         # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_OLD_KEYS=

# Proxy (rate limiting): how many reverse proxies sit in front of the API; the client address is read that far from
# the end of X-Forwarded-For (Render: 1; Cloudflare then Render: 2). TRUST_CLOUDFLARE=1 only if the API is reachable
# through Cloudflare alone.
TRUSTED_PROXY_HOPS=1
TRUST_CLOUDFLARE=0

# Receipt and statement imports (subscription detection). Without a key, CSV imports still work.
ANTHROPIC_API_KEY=
IMPORT_MODEL=                       # default claude-opus-5-5
IMPORT_DAILY_LIMIT=20               # uploads per user per 24h (Pro gets 5x)

# Jobs
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=0
ALT_DATA_ALLOWED_HOSTS=
